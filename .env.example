# NULL configuration. Copy to .env. Secrets stay on the server; nothing here reaches the browser.

# --- Core ---
NULL_DATABASE_URL=postgresql+psycopg://localhost/null_app
# Required outside local dev. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NULL_SECRET_KEY=
NULL_ENV=development
NULL_CORS_ORIGINS=http://localhost:3000

# --- Demo accounts ---
# Seeded users share this password. Leave empty to generate one; `make seed` prints it.
NULL_DEMO_PASSWORD=

# --- Meta Model API ---
# Without a key NULL runs in Deterministic reasoning mode and says so in the interface.
# Variable name matches Meta's documentation.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# No default on purpose: choose a model your key can reach (Settings > AI lists them live).
# IDs ending in -contributor may be used to train Meta's models, so NULL refuses them
# unless NULL_ALLOW_CONTRIBUTOR_MODELS=true.
META_MODEL_ID=
NULL_ALLOW_CONTRIBUTOR_MODELS=false
# Inputs for the role loop. See https://dev.meta.ai/docs
META_REASONING_EFFORT=medium
